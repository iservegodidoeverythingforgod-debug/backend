# ==============================================================================
# Seed Store Backend - Local Automated Test Environment Configuration (.env.test)
# ==============================================================================
# This template is used for running local integration and unit tests in isolation
# without touching production or remote Supabase infrastructure.

NODE_ENV=test
PORT=3001

# Database Configuration for Automated Tests
# Use 'sqlite' for zero-dependency in-memory/file-based testing or local PostgreSQL
DB_TYPE=sqlite
DATABASE_URL=test.sqlite
DB_SYNCHRONIZE=true

# JWT Secrets for Test Environment (Predictable deterministic secrets)
JWT_ACCESS_SECRET=test_access_jwt_secret_key_for_unit_and_integration_testing_12345!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=test_refresh_jwt_secret_key_for_unit_and_integration_testing_12345!
JWT_REFRESH_EXPIRATION=7d

# CORS & Security
CORS_ORIGIN=*

# Supabase Storage S3 Mock Configuration for Testing
# Tests mock the S3Client / SupabaseStorageService directly, but these fallback values ensure safe parsing
SUPABASE_S3_ENDPOINT=https://mock-test-project.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=mock_test_access_key
SUPABASE_S3_SECRET_ACCESS_KEY=mock_test_secret_key
SUPABASE_STORAGE_PUBLIC_BASE_URL=https://mock-test-project.supabase.co/storage/v1/object/public

# Email / OTP Mocking
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=test@seedstore.local
